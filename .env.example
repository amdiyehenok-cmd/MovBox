# --- TMDB ----------------------------------------------------------------
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Supabase (auth + DB) -----------------------------------------------
# Free tier: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- h5-api upstream (the source of truth for content metadata) --------
# Bearer auth is minted in the Next.js process. Override only if you
# know what you're doing.
H5_API_BASE=https://h5-api.aoneroom.com/wefeed-h5api-bff

# --- Thin stream relay (also used by the Android app) -----------------
# The Next.js app calls this for /stream (source list + captions) only.
# Home / search / browse / detail / anime go directly through h5-api.
# Same relay the Android app uses, so behaviour is identical.
STREAM_RELAY_URL=https://p01--movbox-api--d6kx854d4rvy.code.run

# --- Site ----------------------------------------------------------------
# Used for canonical URLs in sitemap + metadata
NEXT_PUBLIC_SITE_URL=https://movbox.xyz

# --- Adsterra -------------------------------------------------------------
# Site-wide social bar + popunder. Both are injected by
# components/ads/AdsterraScripts.tsx on every route (the popunder is held
# back on /watch unless NEXT_PUBLIC_ADSTERRA_POPUNDER_ON_WATCH=1).
# Set NEXT_PUBLIC_ADSTERRA_ENABLED=0 to switch the whole thing off.
NEXT_PUBLIC_ADSTERRA_ENABLED=1
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_URL=https://pl31180787.profitableratecpmnetwork.com/4d/8e/8e/4d8e8e8c319c3cfa4ed4d9338662515f.js
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=https://pl31180785.profitableratecpmnetwork.com/c8/63/1f/c8631f19a926b1ce86bd661e287e1538.js
NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=https://www.profitableratecpmnetwork.com/yze0wqd6?key=f4fe1371dae7e93cde4f80cf5953c03f
# The popunder is deliberately NOT fired on /watch (it would fight the player).
# Flip to 1 only if you want it there too.
NEXT_PUBLIC_ADSTERRA_POPUNDER_ON_WATCH=0

# --- Hilltop --------------------------------------------------------------
# One zone code per placement. A slot with no zone configured renders
# NOTHING (no empty box, no reserved space), so you can enable placements
# one at a time. Paste the zone's JS snippet into the matching value --
# the injector handles a bare URL, a raw JS body, or a full HTML snippet.
NEXT_PUBLIC_HILLTOP_ENABLED=1
NEXT_PUBLIC_HILLTOP_ZONE_LEADERBOARD=
NEXT_PUBLIC_HILLTOP_ZONE_INFEED=
NEXT_PUBLIC_HILLTOP_ZONE_DETAIL=
NEXT_PUBLIC_HILLTOP_ZONE_SIDEBAR=
NEXT_PUBLIC_HILLTOP_ZONE_FOOTER=
NEXT_PUBLIC_HILLTOP_ZONE_BLOG=
NEXT_PUBLIC_HILLTOP_ZONE_WATCH=
